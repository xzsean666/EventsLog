{
  "name": "@eventslog/node",
  "version": "0.1.0",
  "description": "Zero-Code Function Observability SDK for Node.js",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.mjs",
      "require": "./dist/register.js"
    },
    "./loader": {
      "types": "./dist/loader/esm.d.ts",
      "import": "./dist/loader/esm.mjs",
      "require": "./dist/loader/esm.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "observability",
    "tracing",
    "telemetry",
    "apm",
    "profiling"
  ],
  "author": "EventsLog Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.4.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
