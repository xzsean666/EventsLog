{
  "name": "@eventslog/flutter",
  "version": "0.1.0",
  "description": "Zero-Code Function Observability and AST Instrumentation CLI for Flutter / Dart",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "eventslog-flutter": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "lib",
    "pubspec.yaml"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "observability",
    "tracing",
    "telemetry",
    "apm",
    "flutter",
    "dart",
    "ast",
    "instrumentation"
  ],
  "author": "EventsLog Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.4.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
